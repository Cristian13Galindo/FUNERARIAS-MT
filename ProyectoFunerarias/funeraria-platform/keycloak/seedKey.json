{
  "realm": "funeraria-realm",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role"
      },
      {
        "name": "operario",
        "description": "Operator role"
      }
    ]
  },
  "clients": [
    {
